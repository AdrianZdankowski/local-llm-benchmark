+def _env_endpoint_factory(
+    module: str, klass: str, url_var: str, model_var: str, key_var: str
+) -> Callable[..., BaseRole]:
+    """OpenAI-compatible role whose endpoint/model/key come from env vars at construction."""
+
+    def _ctor(*args: Any, **user_kwargs: Any) -> BaseRole:
+        kwargs = {
+            "base_url": os.environ[url_var],
+            "model_name": os.environ[model_var],
+            "api_key": os.environ.get(key_var, "EMPTY"),
+        }
+        return _lazy_factory(module, klass, kwargs=kwargs)(*args, **user_kwargs)
+
+    return _ctor
+
